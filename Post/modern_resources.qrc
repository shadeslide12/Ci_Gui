<RCC>
    <qresource prefix="/styles">
        <file>ModernStyle.qss</file>
    </qresource>
    
    <qresource prefix="/icons">
        <!-- 对象类型图标 -->
        <file alias="mesh.png">icons/mesh.png</file>
        <file alias="contour.png">icons/contour.png</file>
        <file alias="vector.png">icons/vector.png</file>
        <file alias="boundary.png">icons/boundary.png</file>
        <file alias="display.png">icons/display.png</file>
        <file alias="isosurface.png">icons/isosurface.png</file>
        <file alias="slice.png">icons/slice.png</file>
        
        <!-- 工具栏图标 -->
        <file alias="open.png">icons/open.png</file>
        <file alias="save.png">icons/save.png</file>
        <file alias="export.png">icons/export.png</file>
        <file alias="settings.png">icons/settings.png</file>
        <file alias="refresh.png">icons/refresh.png</file>
        
        <!-- 视图图标 -->
        <file alias="view_3d.png">icons/view_3d.png</file>
        <file alias="view_xy.png">icons/view_xy.png</file>
        <file alias="view_xz.png">icons/view_xz.png</file>
        <file alias="view_yz.png">icons/view_yz.png</file>
        
        <!-- UI元素图标 -->
        <file alias="check.png">icons/check.png</file>
        <file alias="down-arrow.png">icons/down-arrow.png</file>
        <file alias="branch-closed.png">icons/branch-closed.png</file>
        <file alias="branch-open.png">icons/branch-open.png</file>
    </qresource>
</RCC>
