/* Post专用蓝色主题 */

/* 主窗口 - 纯白色背景 */
QMainWindow {
    background-color: #ffffff;
}

QWidget {
    background-color: #ffffff;
}

/* 中心widget - 纯白色 */
QWidget#centralwidget {
    background-color: #ffffff;
}

QWidget#widget_2 {
    background-color: #ffffff;
}

/* 工具栏 - 蓝色渐变 */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4a8fc4, stop:1 #3d87c2);
    border-bottom: 1px solid #2e6ca6;
    spacing: 3px;
    padding: 3px;
}

QToolButton {
    background-color: transparent;
    color: white;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 5px;
    margin: 1px;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.3);
}

/* 状态栏 - 蓝色渐变 */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3d87c2, stop:1 #2e6ca6);
    color: white;
    border-top: 1px solid #2e6ca6;
    padding: 3px;
    font-weight: bold;
}

QStatusBar QLabel {
    color: white;
}

/* 菜单栏 - 蓝色渐变背景，白色文字 */
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5a9fd4, stop:1 #4a8fc4);
    border-bottom: 2px solid #3d87c2;
    padding: 3px;
    color: white;
}

QMenuBar::item {
    padding: 5px 10px;
    background-color: transparent;
    color: white;
    font-weight: bold;
}

QMenuBar::item:selected {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
}

QMenuBar::item:pressed {
    background-color: rgba(255, 255, 255, 0.3);
}

/* 按钮 - 蓝色悬停 */
QPushButton {
    background-color: #f0f0f0;
    border: 1px solid #b0b0b0;
    border-radius: 3px;
    padding: 5px 12px;
    min-height: 22px;
    color: #333333;
}

QPushButton:hover {
    background-color: #e3f2fd;
    border: 1px solid #2196f3;
}

QPushButton:pressed {
    background-color: #bbdefb;
}

QPushButton:disabled {
    background-color: #e0e0e0;
    color: #a0a0a0;
}

/* 下拉菜单 - 白色背景 */
QMenu {
    background-color: #ffffff;
    border: 1px solid #3d87c2;
    padding: 3px;
}

QMenu::item {
    padding: 5px 25px 5px 10px;
    background-color: transparent;
    color: #333333;
}

QMenu::item:selected {
    background-color: #e3f2fd;
    color: #333333;
}

QMenu::separator {
    height: 1px;
    background-color: #d0d0d0;
    margin: 3px 0px;
}

/* 停靠窗口标题 */
QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5a9fd4, stop:1 #4a8fc4);
    color: white;
    padding: 6px;
    border-bottom: 1px solid #3d87c2;
    text-align: left;
    font-weight: bold;
}

/* 左侧控制面板 - 纯白色背景 */
QScrollArea {
    background-color: #ffffff !important;
    border: 1px solid #d0d0d0;
}

QScrollArea > QWidget {
    background-color: #ffffff !important;
}

QScrollArea QWidget#scrollAreaWidgetContents_2 {
    background-color: #ffffff !important;
}

/* 标签 - 纯白色背景 */
QLabel {
    background-color: transparent;
    color: #333333;
}

/* 复选框和单选按钮 */
QCheckBox, QRadioButton {
    background-color: transparent;
    color: #333333;
}

/* 分组框 - 纯白色背景 */
QGroupBox {
    background-color: #ffffff !important;
    border: 1px solid #d0d0d0;
    margin-top: 10px;
    padding-top: 10px;
    color: #333333;
}

QGroupBox::title {
    color: #333333;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    background-color: #ffffff !important;
}

/* QPushButton在控制面板中 - 纯白色背景 */
QScrollArea QPushButton {
    background-color: #ffffff !important;
    border: 1px solid #b0b0b0;
    border-radius: 3px;
    padding: 5px 12px;
    min-height: 22px;
    color: #333333;
}

QScrollArea QPushButton:hover {
    background-color: #e3f2fd !important;
    border: 1px solid #2196f3;
}
